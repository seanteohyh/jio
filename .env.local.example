# ---------------------------------------------------------------------------
# Jio environment variables
#
# Copy this file to `.env.local` and fill in what you need.
# With NOTHING filled in, the app runs in demo mode with in-memory seed data.
# ---------------------------------------------------------------------------

# --- Data layer -----------------------------------------------------------
# Which repository implementation to use: "auto" | "demo" | "supabase"
# "auto" picks supabase when the Supabase URL + anon key are present, else demo.
JIO_DATA_ADAPTER=auto

# Supabase (required for live mode, not needed in demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used ONLY by the discovery cron and seed scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Force demo mode even when Supabase is configured.
NEXT_PUBLIC_DEMO_MODE=true

# --- Auth -----------------------------------------------------------------
# How people sign in. "auto" | "demo" | "name" | "email"
#
#   demo  — everyone is the same fixed user. No sign-in.
#   name  — type your name, that's it. Distinct users, no email, no password.
#           Needs "Anonymous sign-ins" enabled in the Supabase dashboard
#           (Authentication -> Providers), and migration 015 applied.
#   email — passwordless magic link plus a 6-digit code. Needs custom SMTP.
#
# "auto" picks demo without Supabase configured, and name with it.
# Switching modes later changes nothing else: both sit on the same auth.users
# table, so ids, history and display names all survive the change.
NEXT_PUBLIC_JIO_AUTH_ADAPTER=auto

# Only meaningful in email mode. False = existing users only.
NEXT_PUBLIC_JIO_OPEN_SIGNUP=true

# --- Routing provider (walking times) ------------------------------------
# "auto" | "onemap" | "haversine"
JIO_ROUTING_PROVIDER=auto
# Register free at https://www.onemap.gov.sg/apidocs/register
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# --- Weather provider -----------------------------------------------------
# "nea" | "none"
JIO_WEATHER_PROVIDER=nea

# --- Discovery provider ---------------------------------------------------
# "overpass" | "none"
JIO_DISCOVERY_PROVIDER=overpass
# Overpass mirror. Override if the default is rate limiting you.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Cron -----------------------------------------------------------------
# Protects /api/cron/discover. Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Feature flags --------------------------------------------------------
# Comma-separated list of features to DISABLE. Leave blank to enable everything.
# Valid keys: events, kakis, wishlist, recos, lobangs, blogImport, discovery,
#             weather, map, metrics, roulette, reviews, offices
NEXT_PUBLIC_JIO_DISABLED_FEATURES=

# --- Branding -------------------------------------------------------------
NEXT_PUBLIC_JIO_APP_NAME=Jio
NEXT_PUBLIC_JIO_OFFICE_NAME=LazadaOne
NEXT_PUBLIC_JIO_OFFICE_LAT=1.2966
NEXT_PUBLIC_JIO_OFFICE_LNG=103.8520
